  steps:
  - instructionText: Pulsa W para avanzar.
    requiredAction: 0
  - instructionText: "Pulsa S para ir hacia atr\xE1s."
    requiredAction: 1
  - instructionText: Pulsa A para moverte hacia la izquierda.
    requiredAction: 2
  - instructionText: Pulsa D para moverte hacia la derecha
    requiredAction: 3
  - instructionText: "Mueve el rat\xF3n para rotar la c\xE1mara."
    requiredAction: 4
  - instructionText: "Ac\xE9rcate a un objeto y pulsa E para interactuar."
    requiredAction: 5
  - instructionText: "Tutorial completado. \xA1Escapa de la sala!"
    requiredAction: 6
